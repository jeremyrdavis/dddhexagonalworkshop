# WildFly CLI script to setup PostgreSQL datasource and other configurations
# Run this script with: $WILDFLY_HOME/bin/jboss-cli.sh --connect --file=wildfly-setup.cli

# Add PostgreSQL module (if not already present)
module add --name=org.postgresql --resources=postgresql-42.7.3.jar --dependencies=javax.api,javax.transaction.api

# Add PostgreSQL driver
/subsystem=datasources/jdbc-driver=postgresql:add(driver-name=postgresql,driver-module-name=org.postgresql,driver-class-name=org.postgresql.Driver)

# Add PostgreSQL datasource
/subsystem=datasources/data-source=PostgreSQLDS:add(\
    jndi-name=java:jboss/datasources/PostgreSQLDS,\
    connection-url=jdbc:postgresql://localhost:5432/attendeedb,\
    driver-name=postgresql,\
    user-name=attendee_user,\
    password=attendee_password,\
    validate-on-match=true,\
    background-validation=false,\
    valid-connection-checker-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLValidConnectionChecker,\
    exception-sorter-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLExceptionSorter\
)

# Enable the datasource
/subsystem=datasources/data-source=PostgreSQLDS:enable

# Add some logging configuration
/subsystem=logging/logger=com.conference.attendees:add(level=INFO)

# Reload the server to apply changes
:reload